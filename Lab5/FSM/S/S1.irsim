ana S0 !S2 !reset out

h Vdd!
l GND!

# Test All States w/o reset (out = S0 & !S2)
h !reset

# S0 = 0 & !S2 = 0 

l S0 !S2
s
assert out 1

# S0 = 0 & !S2 = 1
l S0
h !S2
s
assert out 0

# S0 = 1 & !S2 = 0
h S0
l !S2
s
assert out 0

# S0 = 1 & !S2 = 1
h S0 !S2
s
assert out 0

# Check reset condition

h S0 !S2 
l !reset
s
assert out 1
