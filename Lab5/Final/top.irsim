### 0 & 0 (H = 0, L = 0)

input 10000000000
c
c
input 10000000000
c
c
c
assert H 0000000000
assert L 100000000000

### 2 & 0 (H = -1, L = 1)

input 10000000010
c
c
input 10000000000
