# analyze and initialize all I/O pins

h Vdd!
l GND!

vector clk phi0 phi1
clock clk 10 00 01 00


vector input in i0 i1 i2 i3 i4 i5 i6 i7 i8 i9
vector H H0 H1 H2 H3 H4 H5 H6 H7 H8 H9
vector L out_valid L0 L1 L2 L3 L4 L5 L6 L7 L8 L9
vector state S0 S1 S2

ana S0 S1 S2

### Test Reset
c
c
h reset
c
assert state 111
l reset
c
assert state 000


### Standard Tests


### 1 & 1 (H = 0, L = 1)

input 10000000001
c
c
c
c
c
assert H 0000000000
assert L 100000000001

### 2 & 4 (H = 1, L = 3)

input 10000000010
c
c
input 10000000100
c
c
c
assert H 0000000001
assert L 100000000011


